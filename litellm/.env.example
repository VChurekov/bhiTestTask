# ============================================
# LiteLLM
# ============================================

# Мастер-ключ для административного доступа к LiteLLM
# Используется для управления моделями, ключами и т.д.
LITELLM_MASTER_KEY=sk-a7f3k9m2p8q1x4z6w5e0r7t3y9u2i8o5

# Соль для шифрования чувствительных данных в БД
LITELLM_SALT_KEY=9d1e5b7a3c8f2e6d0b4a9c1f7e3d8b5a2c6f9e1d4b7a0c3f8e5d2b6a9c1f4e7d

# Сохранять модели в БД
STORE_MODEL_IN_DB=True

# Порт, на котором LiteLLM слушает внутри контейнера и наружу
LITELLM_PORT=4000

# ============================================
# PostgreSQL (LiteLLM DB)
# ============================================

POSTGRES_USER=litellm
POSTGRES_PASSWORD=Wq2Zr6Xn0Yb4Vd8Kf1Lm5Pj9St3Gc7H
POSTGRES_DB=litellm

# Порт (если понадобится пробросить наружу), по умолчанию не публикуется
POSTGRES_PORT=5432

# ============================================
# Сборный DATABASE_URL для LiteLLM
# Собирается из переменных выше
# ============================================
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@litellm-db:5432/${POSTGRES_DB}